@model IEnumerable<gestion_de_permiso_de_usuario.Models.Permiso>

@{
    ViewData["Title"] = "Lista de Permisos";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Permiso</a>
</p>
<div class="table-responsive">
    <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>
                    Nombre del Permiso
                </th>
                <th>
                    Descripción
                </th>
                <th>
                    Estado
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NombrePermiso)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        @if (item.Estado == 1)
                        {
                            <span>Activo</span>
                        }
                        else if (item.Estado == 0)
                        {
                            <span>Desactivado</span>
                        }
                        else
                        {
                            <span>Estado no válido</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group" aria-label="Basic example">
                            <a asp-action="Edit" asp-route-id="@item.PermisoID" class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.PermisoID" class="btn btn-info"><i class="bi bi-eye"></i></a>
                           @*  <a asp-action="Delete" asp-route-id="@item.PermisoID" class="btn btn-danger"><i class="bi bi-trash"></i></a> *@
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
