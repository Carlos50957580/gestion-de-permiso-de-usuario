@model gestion_de_permiso_de_usuario.Models.Permiso

@{
    ViewData["Title"] = "Crear Permiso";
}
<form asp-action="Create" class="needs-validation form-register" novalidate>
    <div class="form-group">

        <h4>Formulario Permiso</h4>
        <label asp-for="NombrePermiso" class="control-label">Nombre del Permiso</label>
        <input asp-for="NombrePermiso" class="form-control" required />
        <div class="invalid-feedback">Introduzca el nombre del permiso</div>
    </div>
    <div class="form-group">
        <label asp-for="Descripcion" class="control-label">Descripción</label>
        <input asp-for="Descripcion" class="form-control" required />
        <div class="invalid-feedback">Introduzca una descripcion</div>
    </div>
    @* <div class="form-group">
    <label asp-for="CreadoPor" class="control-label">Creado Por</label>
    <input asp-for="CreadoPor" class="form-control" />
    <span asp-validation-for="CreadoPor" class="text-danger"></span>
    </div> *@
    <br />
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Crear</button> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</form>
