@model gestion_de_permiso_de_usuario.Models.Permiso

@{
    ViewData["Title"] = "Editar Permiso";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4>Formulario Editar Permiso</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <input type="hidden" asp-for="PermisoID" />

                <div class="form-group">
                    <label asp-for="NombrePermiso" class="control-label">Nombre del Permiso</label>
                    <input asp-for="NombrePermiso" class="form-control" required placeholder="Ingresa un nombre para el permiso"/>
                    <div class="invalid-feedback">
                        Por favor ingresa un nombre de permiso
                    </div>
                    <span asp-validation-for="NombrePermiso" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Descripcion" class="control-label">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" required placeholder="Ingresa un descripción para el rol" />
                    <div class="invalid-feedback">
                        Por favor ingresa la descripción
                    </div>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Estado" class="control-label">Estado</label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<gestion_de_permiso_de_usuario.Models.EstadoPermiso>()" class="form-control" required>
                        <option value="">Selecciona el Estado</option>
                    </select>
                    <div class="invalid-feedback">
                        Por favor selecciona el estado
                    </div>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
