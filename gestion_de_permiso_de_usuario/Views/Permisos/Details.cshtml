@model gestion_de_permiso_de_usuario.Models.Permiso

@{
    ViewData["Title"] = "Detalles del Permiso";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Información de el permiso</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nombre del Permiso:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NombrePermiso)</dd>

                <dt class="col-sm-3">Descripción:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

                <dt class="col-sm-3">Estado:</dt>
                <dd class="col-sm-9">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else if (Model.Estado == 0)
                    {
                        <span class="badge bg-danger">Desactivado</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Estado no válido</span>
                    }
                </dd>

                <dt class="col-sm-3">Creado Por:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CreadoPor)</dd>

                <dt class="col-sm-3">Fecha de Cambio:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaCambio)</dd>

                <dt class="col-sm-3">Actualizado Por:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ActualizadoPor)</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.PermisoID" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </div>
</div>
