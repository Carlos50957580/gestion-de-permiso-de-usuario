@model gestion_de_permiso_de_usuario.Models.Permiso

@{
    ViewData["Title"] = "Detalles del Permiso";
}


<div>
    <h4 class="DRol">Informacion vigente sobre el permiso @Html.DisplayFor(model => model.NombrePermiso)</h4>
    <hr />

    <table class="table table-borderless display TPermiso">
        <thead>
        </thead>
        <tbody>
            <tr>
                <th class="Titulo">Nombre del Permiso</th>
                <th class="SinTitulo">@Html.DisplayFor(model => model.NombrePermiso)</th>
            </tr>
            <tr>
                <td class="Titulo">Descripción</td>
                <td>@Html.DisplayFor(model => model.Descripcion)</td>
            </tr>
            <tr>
                <td class="Titulo">Estado</td>
                <td>
                    @if (Model.Estado == 1)
                    {
                        <span>Activo</span>
                    }
                    else if (Model.Estado == 0)
                    {
                        <span>Desactivado</span>
                    }
                    else
                    {
                        <span>Estado no válido</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="Titulo">Creado Por</td>
                <td>@Html.DisplayFor(model => model.CreadoPor)</td>
            </tr>
            <tr>
                <td class="Titulo">Fecha de Cambio</td>
                <td>@Html.DisplayFor(model => model.FechaCambio)</td>
            </tr>
            <tr>
                <td class="Titulo">Actualizado Por</td>
                <td>@Html.DisplayFor(model => model.ActualizadoPor)</td>
            </tr>
        </tbody>
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.PermisoID" class="btn btn-primary">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
