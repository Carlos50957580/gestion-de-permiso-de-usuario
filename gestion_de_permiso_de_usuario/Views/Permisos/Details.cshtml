@model gestion_de_permiso_de_usuario.Models.Permiso

@{
    ViewData["Title"] = "Detalles del Permiso";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Permiso</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Nombre del Permiso
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NombrePermiso)
        </dd>
        <dt class="col-sm-2">
            Descripción
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @if (Model.Estado == 1)
            {
                <span>Activo</span>
            }
            else if (Model.Estado == 0)
            {
                <span>Desactivado</span>
            }
            else
            {
                <span>Estado no válido</span>
            }
        </dd>
        <dt class="col-sm-2">
            Creado Por
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreadoPor)
        </dd>
        <dt class="col-sm-2">
            Fecha de Cambio
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaCambio)
        </dd>
        <dt class="col-sm-2">
            Actualizado Por
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ActualizadoPor)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.PermisoID" class="btn btn-warning">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
