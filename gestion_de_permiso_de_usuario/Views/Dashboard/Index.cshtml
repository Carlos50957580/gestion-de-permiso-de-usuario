@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<head>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/css/style.css")" />
</head>

<div class="container">
    <div class="row">

        <!-- Tarjeta para Total Usuarios -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Usuarios <span>| Registrados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-people-fill total-usuarios"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalUsuarios == 0)
                            {
                                <span>Informacion no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalUsuarios</h2>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Roles -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Roles <span>| Agregados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-badge-fill total-roles"></i>
                        </div>
                        <div class="ps-3">

                            @if (Model.TotalRoles == 0)
                            {
                                <span>Informacion no disponible</span>
                            }

                            else
                            {
                                <h2 class="card-text">@Model.TotalRoles</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Permisos -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Permisos <span>| Agregados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-shield-lock-fill total-permisos"></i>
                        </div>
                        <div class="ps-3">

                            @if (Model.TotalPermisos == 0)
                            {
                                <span>Informacion no disponible</span>
                            }


                            else
                            {
                                <h2 class="card-text">@Model.TotalPermisos</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Tarjeta para Total personas -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Personas <span>| Registradas</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-shield-lock-fill total-permisos"></i>
                        </div>
                        <div class="ps-3">

                            @if (Model.Totalpersonas == 0)
                            {
                                <span>Informacion no disponible</span>
                            }


                            else
                            {
                                <h2 class="card-text">@Model.Totalpersonas</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">


<div class="container">
    <div class="row">


        @if (Model.TotalPermisos == 0)
        {
            //no hay nada xd
        }

        else
        {
            <!-- Gráfico de pastel: Permisos Activos vs Inactivos -->
            <div class="col-lg-4">
                <canvas id="permisosActivosInactivosChart"></canvas>
                <h5 class="card-title text-center">Permisos activos e inactivos</h5>
            </div>
        }


        @if (Model.TotalUsuarios == 0)
        {
            //no hay nada xd
        }
        else
        {
           

            <!-- Gráfico de pastel: Usuarios Activos vs Inactivos -->
            <div class="col-lg-4">
                <canvas id="usuariosActivosInactivosChart"></canvas>
                <h5 class="card-title text-center">Usuarios activos e inactivos</h5>

            </div>
        }
       


        @if (Model.TotalRoles == 0)
        {
            //no hay nada xd

        }

        else
        {
            <!-- Gráfico de pastel: Roles Activos vs Inactivos -->
            <div class="col-lg-4">
                <canvas id="rolesActivosInactivosChart"></canvas>
                <h5 class="card-title text-center">Roles activos e inactivos</h5>

            </div>
        }
      

    </div>

    <!-- Gráfico de barras: Cantidad de usuarios por rol -->
    <div class="row">
        <div class="col-lg-12">
            <canvas id="usuariosPorRolChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Gráfico de pastel: Usuarios Activos vs Inactivos
    var ctxUsuarios = document.getElementById('usuariosActivosInactivosChart').getContext('2d');
    var usuariosActivosInactivosChart = new Chart(ctxUsuarios, {
        type: 'pie',
        data: {
            labels: ['Activos', 'Inactivos'],
            datasets: [{
                data: [@Model.TotalUsuariosActivos, @Model.TotalUsuariosInactivos],
                backgroundColor: ['#4CAF50', '#F44336'],
                borderColor: ['#4CAF50', '#F44336'],
                borderWidth: 1
            }]
        }
    });

    // Gráfico de pastel: Roles Activos vs Inactivos
    var ctxRoles = document.getElementById('rolesActivosInactivosChart').getContext('2d');
    var rolesActivosInactivosChart = new Chart(ctxRoles, {
        type: 'pie',
        data: {
            labels: ['Activos', 'Inactivos'],
            datasets: [{
                data: [@Model.TotalRolesActivos, @Model.TotalRolesInactivos],
                backgroundColor: ['#2196F3', '#FFC107'],
                borderColor: ['#2196F3', '#FFC107'],
                borderWidth: 1
            }]
        }
    });

    // Gráfico de pastel: Permisos Activos vs Inactivos

    
    var ctxPermisos = document.getElementById('permisosActivosInactivosChart').getContext('2d');
    var permisosActivosInactivosChart = new Chart(ctxPermisos, {
        type: 'pie',
        data: {
            labels: ['Activos', 'Inactivos'],
            datasets: [{
                data: [@Model.TotalPermisosActivos, @Model.TotalPermisosInactivos],
                backgroundColor: ['#FF5722', '#9C27B0'],
                borderColor: ['#FF5722', '#9C27B0'],
                borderWidth: 1
            }]
        }
    });

</script>

