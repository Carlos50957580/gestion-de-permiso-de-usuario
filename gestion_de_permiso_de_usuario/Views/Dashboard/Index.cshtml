                backgroundColor: ['#4CAF50', '#F44336']
            }]
        },
        options: {
            responsive: true, // Responsivo
            plugins: {
                legend: {
                   
                }
            }
        }
    });
</script>


<!-- rolesChart.js -->
<script>
    var ctx3 = document.getElementById('rolesChart').getContext('2d');
    var rolesChart = new Chart(ctx3, {
        type: 'pie',
        data: {
            labels: ['Roles Activos', 'Roles Inactivos'],
            datasets: [{
                data: [@Model.TotalRolesActivos, @Model.TotalRolesInactivos],
                backgroundColor: ['#2196F3', '#FFC107']
            }]
        },
        options: {
            responsive: true, // Responsivo
            plugins: {
                legend: {
                   
                }
            }
        }
    });
</script>

   