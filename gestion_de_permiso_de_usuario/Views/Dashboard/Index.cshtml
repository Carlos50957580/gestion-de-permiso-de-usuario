@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<head>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/css/style.css")" />
    <script src="https://cdn.jsdelivr.net/npm/plotly.js-dist-min@2.10.0/dist/plotly.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


</head>

<div class="container">
    <div class="row">

        <!-- Tarjeta para Total Usuarios -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Usuarios <span>| Registrados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-people-fill total-usuarios"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalUsuarios == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalUsuarios</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Roles -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Roles <span>| Agregados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-badge-fill total-roles"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalRoles == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalRoles</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Permisos -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Permisos <span>| Agregados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-shield-lock-fill total-permisos"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalPermisos == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalPermisos</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Personas -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Personas <span>| Registradas</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-fill total-personas"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.Totalpersonas == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.Totalpersonas</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



<div class="container">
    <div class="row">

        <!-- Gráfico de Permisos -->
        <div class="col-xxl-4 col-md-6">
            
                    <canvas id="permisosChart"></canvas>
           
        </div>

        <!-- Gráfico de Usuarios -->
        <div class="col-xxl-4 col-md-6">
           
                    <canvas id="usuariosChart"></canvas>
            
        </div>

        <!-- Gráfico de Roles -->
        <div class="col-xxl-4 col-md-6">
          
                    <canvas id="rolesChart"></canvas>
                </div>
    
</div>


    <style>
        /* Estilo general para los contenedores */
        .container {
            padding: 15px;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
        }

        .col-xxl-4, .col-md-6 {
            box-sizing: border-box;
        }

        canvas {
            width: 100% !important; /* Fuerza a que el gráfico ocupe el 100% del contenedor */
            height: auto !important; /* Mantiene la proporción del gráfico */
            display: block; /* Elimina el espacio adicional debajo del canvas */
        }
    </style>
<!-- permisosChart.js -->
<script>
    var ctx1 = document.getElementById('permisosChart').getContext('2d');
    var permisosChart = new Chart(ctx1, {
        type: 'pie',
        data: {
            labels: ['Permisos Activos', 'Permisos Inactivos'],
            datasets: [{
                data: [@Model.TotalPermisosActivos, @Model.TotalPermisosInactivos],
                backgroundColor: ['#FF5722', '#9C27B0']
            }]
        },
        options: {
            responsive: true, // Responsivo
            plugins: {
                legend: {
                  
                }
            }
        }
    });
</script>


   

