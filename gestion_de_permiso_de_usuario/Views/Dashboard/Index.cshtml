@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<head>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/css/style.css")" />
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
</head>

<div class="container">
    <div class="row">

        <!-- Tarjeta para Total Usuarios -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Usuarios <span>| Registrados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-people-fill total-usuarios"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalUsuarios == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalUsuarios</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Roles -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Roles <span>| Agregados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-badge-fill total-roles"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalRoles == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalRoles</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Permisos -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Permisos <span>| Agregados</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-shield-lock-fill total-permisos"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.TotalPermisos == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.TotalPermisos</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta para Total Personas -->
        <div class="col-xxl-3 col-md-6">
            <div class="card info-card">
                <div class="card-body">
                    <h5 class="card-title">Personas <span>| Registradas</span></h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-fill total-personas"></i>
                        </div>
                        <div class="ps-3">
                            @if (Model.Totalpersonas == 0)
                            {
                                <span>Información no disponible</span>
                            }
                            else
                            {
                                <h2 class="card-text">@Model.Totalpersonas</h2>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="container">
    <div class="row">
        @if (Model.TotalPermisos > 0)
        {
            <!-- Gráfico de Permisos Activos vs Inactivos -->
            <div class="col-lg-4">
                <div id="permisosChart"></div>
            </div>
        }

        @if (Model.TotalUsuarios > 0)
        {
            <!-- Gráfico de Usuarios Activos vs Inactivos -->
            <div class="col-lg-4">
                <div id="usuariosChart"></div>
            </div>
        }

        @if (Model.TotalRoles > 0)
        {
            <!-- Gráfico de Roles Activos vs Inactivos -->
            <div class="col-lg-4">
                <div id="rolesChart"></div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script>
    // Función para inicializar los gráficos
    function renderCharts() {
        var permisosOptions = {
            series: [@Model.TotalPermisosActivos, @Model.TotalPermisosInactivos],
            chart: {
                type: 'pie',
                height: 500,
                width: '100%',
                redrawOnParentResize: true, // Se asegura que el gráfico se redibuje al cambiar el tamaño del contenedor
            },
            labels: ['Permisos Activos', 'Permisos Inactivos'],
            colors: ['#FF5722', '#9C27B0'],
            legend: {
                show: false // Esto desactiva la leyenda junto al gráfico
            }
        };
        var permisosChart = new ApexCharts(document.querySelector("#permisosChart"), permisosOptions);
        permisosChart.render();

        var usuariosOptions = {
            series: [@Model.TotalUsuariosActivos, @Model.TotalUsuariosInactivos],
            chart: {
                type: 'pie',
                height: 500,
                width: '100%',
                redrawOnParentResize: true, // Se asegura que el gráfico se redibuje al cambiar el tamaño del contenedor
            },
            labels: ['Usuarios Activos', 'Usuarios Inactivos'],
            colors: ['#4CAF50', '#F44336'],
            legend: {
                show: false // Esto desactiva la leyenda junto al gráfico
            }
        };
        var usuariosChart = new ApexCharts(document.querySelector("#usuariosChart"), usuariosOptions);
        usuariosChart.render();

        var rolesOptions = {
            series: [@Model.TotalRolesActivos, @Model.TotalRolesInactivos],
            chart: {
                type: 'pie',
                height: 500,
                width: '100%',
                redrawOnParentResize: true, // Se asegura que el gráfico se redibuje al cambiar el tamaño del contenedor
            },
            labels: ['Roles Activos', 'Roles Inactivos'],
            colors: ['#2196F3', '#FFC107'],
            legend: {
                show: false // Esto desactiva la leyenda junto al gráfico
            }
        };
        var rolesChart = new ApexCharts(document.querySelector("#rolesChart"), rolesOptions);
        rolesChart.render();

        // Devolver los gráficos para actualización
        return { permisosChart, usuariosChart, rolesChart };
    }

    // Inicializar gráficos
    var charts = renderCharts();

    // Evento para redibujar los gráficos al cambiar el tamaño de la pantalla
    window.addEventListener('resize', function () {
        // Llamar a la función `resize` de cada gráfico para ajustarlo
        charts.permisosChart.resize();
        charts.usuariosChart.resize();
        charts.rolesChart.resize();
    });
</script>
