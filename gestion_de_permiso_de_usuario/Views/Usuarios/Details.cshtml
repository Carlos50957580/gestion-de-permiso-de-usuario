@model gestion_de_permiso_de_usuario.Models.UsuarioConDetalles

@{
    ViewData["Title"] = "Detalles de Usuario";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Información de @Html.DisplayFor(model => model.Nombre) @Html.DisplayFor(model => model.Apellido)</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nombre de Usuario:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreUsuario)</dd>

                <dt class="col-sm-3">Nombre:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-3">Apellido:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Apellido)</dd>

                <dt class="col-sm-3">Rol:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreRol)</dd>

                <dt class="col-sm-3">Estado:</dt>
                <dd class="col-sm-9">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else if (Model.Estado == 0)
                    {
                        <span class="badge bg-danger">Desactivado</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Estado no válido</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Edit" asp-route-id="@Model.UsuarioID" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la Lista</a>
        </div>
    </div>
</div>
