﻿@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
    <li class="breadcrumb-item">Resumen</li>
    <li class="breadcrumb-item active">Usuarios</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="bi bi-people me-1"></i> Lista de Usuarios
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3 mt-3">Nuevo</button>
            </div>

            <hr />
            <table id="tabla" class="display cell-border" style="width: 100%">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Nombre</th>
                        <th>Rol</th>
                        <th>Ultimo cambio</th>
                        <th>Estado</th>
                        <th>Autor</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let listarUsuario = `@Url.Action("ListaUsuarios", "Home")`;

        $.ajax({//Utilizando ajax para obtener los usuarios, recomiendo investigar mas.
            url: '@Url.Action("ListaUsuarios", "Home")', //Llamamos al metodo desde el HomeController
            type: "GET",
            dataType: "Json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                console.log(data)
            }
        })

        $(document).ready(function () {
            $("#tabla").DataTable({
                responsive: true,
                ordering: true,
                paging: true,
                info: true,
                lengthChange: true,
                ajax: {
                    url: listarUsuario,
                    type: "GET",
                    dataType: "json"
                },
                columns: [
                    { data: "nombreUsuario" },
                    { data: "personaID" },
                    { data: "rolID" },
                    { data: "fechaCambio" },
                    {
                        data: "estado", "render": function (valor) {
                            if (valor) {
                                return '<button type="button" class="btn btn-success">Sí</button>'
                            }
                            else {
                                return '<button type="button" class="btn btn-danger">No</button>'
                            }
                        }
                    },
                    { data: "creadoPor" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></button>' +
                            '<button type="button"class="btn btn-danger btn-sm ms-2"><i class="bi bi-trash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "90px"
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-MX.json',
                },
            });
        });
    </script>
}