@model IEnumerable<gestion_de_permiso_de_usuario.Models.Rol>

@{
    ViewData["Title"] = "Lista de Roles";
}

@if (User.IsInRole("Administrador"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo Rol</a>
    </p>
}


<div class="table-responsive">
    <table id="rolesTable" class="display" style="width:100%">
        <thead>
            <tr>
                <th>Nombre del Rol</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.NombreRol)</td>
                    <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                    <td>
                        @if (item.Estado == 1)
                        {
                            <span>Activo</span>
                        }
                        else if (item.Estado == 0)
                        {
                            <span>Inactivo</span>
                        }
                        else
                        {
                            <span>Estado no válido</span>
                        }
                    </td>

                    <td>
                        <div class="btn-group" role="group" aria-label="Basic example">
                            <a asp-action="Edit" asp-route-id="@item.RolID" class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.RolID" class="btn btn-info ms-2"><i class="bi bi-eye"></i></a>
                            <a asp-action="Asignar" asp-route-id="@item.RolID" class="btn btn-success ms-2"><i class="bi bi-person-badge"></i></a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#rolesTable').DataTable({
                "paging": true,
                "searching": true,
                "info": true,
                "lengthChange": true, // Permitir al usuario cambiar el número de registros por página
                "pageLength": 10, // Número de registros por página por defecto
                "language": {
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ registros por página",
                    "zeroRecords": "No se encontraron resultados",
                    "info": "Mostrando página _PAGE_ de _PAGES_",
                    "infoEmpty": "No hay registros disponibles",
                    "infoFiltered": "(filtrado de _MAX_ registros en total)",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

        });
    </script>
}