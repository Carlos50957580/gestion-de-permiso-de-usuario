@model gestion_de_permiso_de_usuario.Models.Rol

@{
    ViewData["Title"] = "Detalles del Rol";
}

<div>
@*     <h4>Rol</h4>
 *@    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Nombre del Rol
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NombreRol)
        </dd>
        <dt class="col-sm-2">
            Descripción
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @if (Model.Estado == 1)
            {
                <span>Activo</span>
            }
            else if (Model.Estado == 0)
            {
                <span>Desactivado</span>
            }
            else
            {
                <span>Estado no válido</span>
            }
        </dd>

        <dt class="col-sm-2">
            Creado Por
        </dt>
       <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreadoPor)
        </dd>
        <dt class="col-sm-2">
            Fecha de Cambio
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaCambio)
        </dd>
        <dt class="col-sm-2">
            Actualizado Por
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ActualizadoPor)
        </dd>
    </dl>

    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.RolID" class="btn btn-warning">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>