@model gestion_de_permiso_de_usuario.Models.Rol

@{
    ViewData["Title"] = "Detalles del Rol";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Información de el rol </h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nombre del Rol:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreRol)</dd>

                <dt class="col-sm-3">Descripción:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

                <dt class="col-sm-3">Estado:</dt>
                <dd class="col-sm-9">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </dd>

                <dt class="col-sm-3">Permisos Asignados:</dt>
                <dd class="col-sm-9">
                    @if (ViewBag.PermisosAsignados is List<gestion_de_permiso_de_usuario.Models.Permiso> permisos && permisos.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var permiso in permisos)
                            {
                                <li>
                                    @permiso.NombrePermiso - @permiso.Descripcion
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No hay permisos asignados.</p>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.RolID" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
        </div>
    </div>
</div>
