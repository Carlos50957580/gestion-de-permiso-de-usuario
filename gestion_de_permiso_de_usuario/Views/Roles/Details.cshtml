@model gestion_de_permiso_de_usuario.Models.Rol

@{
    ViewData["Title"] = "Detalles del Rol";
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Nombre del Rol
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NombreRol)
        </dd>
        <dt class="col-sm-2">
            Descripción
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @if (Model.Estado == 1)
            {
                <span>Activo</span>
            }
            else
            {
                <span>Inactivo</span>
            }
        </dd>

        <hr />
        <dt class="col-sm-2">
            Permisos Asignados
        </dt>
        <dd class="col-sm-10">
            <ul>
                @foreach (var permiso in ViewBag.PermisosAsignados as List<gestion_de_permiso_de_usuario.Models.Permiso>)
                {
                    <ul>
                        <li>@permiso.NombrePermiso - @permiso.Descripcion</li>
                    </ul>

                }
            </ul>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.RolID" class="btn btn-primary">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>