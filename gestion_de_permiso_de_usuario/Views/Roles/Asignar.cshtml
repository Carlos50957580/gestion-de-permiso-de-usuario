@model gestion_de_permiso_de_usuario.Models.Rol
@{
    ViewData["Title"] = "Asignar Permisos";
}

<form asp-action="Asignar" class="form-register">
    <div class="form-group">

        <h4>Permisos</h4>

        <input type="hidden" name="rolId" value="@ViewBag.RolID" class="form-control" />
        <div class="form-group permisos-div">
            @foreach (var permiso in ViewBag.Permisos)
            {
                <div class="form-check">
                    <input class="form-check-input class=" form-control"" type="checkbox" id="permiso-@permiso.PermisoID" name="permisosSeleccionados" value="@permiso.PermisoID">
                    <label class="form-check-label" for="permiso-@permiso.PermisoID">
                        @permiso.NombrePermiso
                    </label>
                </div>
            }
        </div>

    </div>
    <button type="submit" class="btn btn-primary">Asignar</button>
</form>
