@model gestion_de_permiso_de_usuario.Models.AsignarPermisosViewModel

@{
    ViewData["Title"] = "Asignar Permisos";
}

<div class="container mt-4">
    <h2 class="mb-4">Asignar Permisos al Rol: <strong>@Model.NombreRol</strong></h2>

    <form asp-action="Asignar" method="post">
        <input type="hidden" name="rolId" value="@Model.RolID" />

        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Selecciona los permisos para el rol</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Permiso</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permiso in Model.Permisos)
                            {
                                <tr>
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="permiso-@permiso.PermisoID" name="permisosSeleccionados" value="@permiso.PermisoID"
                                            @(Model.PermisosAsignados.Contains(permiso.PermisoID) ? "checked" : "") />
                                            <label class="form-check-label" for="permiso-@permiso.PermisoID">
                                                @permiso.NombrePermiso
                                            </label>
                                        </div>
                                    </td>
                                    <td>@permiso.Descripcion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Asignar Permisos</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
