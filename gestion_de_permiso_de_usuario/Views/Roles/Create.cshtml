@model gestion_de_permiso_de_usuario.Models.Rol

@{
    ViewData["Title"] = "Crear Rol";
}
<form asp-action="Create" class="needs-validation form-register" novalidate>
    <div class="form-group">
        <br />

        <h4>Formulario Rol</h4>

        <label asp-for="NombreRol" class="control-label">Nombre del Rol</label>
        <input asp-for="NombreRol" class="form-control" required />
        <div class="invalid-feedback">Introduzca el nombre del rol</div>
    </div>
    <div class="form-group">
        <label asp-for="Descripcion" class="control-label">Descripción</label>
        <input asp-for="Descripcion" class="form-control" required />
        <div class="invalid-feedback">Introduzca una descripcion</div>
    </div>
    <br />
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Crear</button> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}