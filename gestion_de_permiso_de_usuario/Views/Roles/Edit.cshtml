@model gestion_de_permiso_de_usuario.Models.Rol

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4>Formulario Editar Rol</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <input type="hidden" asp-for="RolID" />

                <div class="form-group">
                    <label asp-for="NombreRol" class="control-label">Nombre del Rol</label>
                    <input asp-for="NombreRol" class="form-control" required placeholder="Ingresa un nombre para el rol" />
                    <div class="invalid-feedback">
                        Introduzca el nombre del rol
                    </div>
                    <span asp-validation-for="NombreRol" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Descripcion" class="control-label">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" required placeholder="Ingresa un descripción para el rol" />
                    <div class="invalid-feedback">
                        Introduzca una descripción
                    </div>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Estado" class="control-label">Estado</label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<gestion_de_permiso_de_usuario.Models.EstadoRol>()" class="form-control" required>
                        <option value="">Selecciona el Estado</option>
                    </select>
                    <div class="invalid-feedback">
                        Seleccione un estado
                    </div>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
