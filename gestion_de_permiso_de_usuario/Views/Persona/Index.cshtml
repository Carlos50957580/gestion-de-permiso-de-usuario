@{    
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
    <li class="breadcrumb-item">Resumen</li>
    <li class="breadcrumb-item active">Personas</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="bi bi-people me-1"></i> Lista de Personas
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3 mt-3" onclick="abrirModal(null)">Nuevo</button>
            </div>

            <hr />
            <table id="tabla" class="display cell-border" style="width: 100%">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Fecha de nacimiento</th>
                        <th>Genero</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>Ultimo cambio</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal" tabindex="-1" id="formodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body g-2">

                <input id="txtId" type="hidden" value="0"/>

                <div class="row">

                    <form>

                        <div class="mb-3">
                            <label for="txtNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="txtNombre">
                        </div>

                        <div class="mb-3">
                            <label for="txtApellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="txtApellido">
                        </div>

                        <div class="mb-3">
                            <label for="txtNac" class="form-label">Fecha de nacimiento</label>
                            <input type="text" class="form-control" id="txtNac">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Sexo</label>
                            <select class="form-select" id="cboSexo" aria-label="Default select example">
                                <option selected>Selecciona tu sexo</option>
                                <option value="1">Hombre</option>
                                <option value="2">Mujer</option>
                                <option value="3">Otro</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="txtTelefono" class="form-label">Numero de telefono</label>
                            <input type="text" class="form-control" id="txtTelefono">
                        </div>

                        <div class="mb-3">
                            <label for="textCorreo" class="form-label">Correo </label>
                            <input type="text" class="form-control" id="textCorreo">
                        </div>
                              
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var table;
        var filaSeleccionada;
        let listarPersona = `@Url.Action("ListaPersonas", "PersonaController")`;
        let GuardarPersona = `@Url.Action("GuardarPersona", "PersonaController")`;

        function abrirModal(Json) {

            $("#txtId").val(0);
            $("#txtNombre").val("");
            $("#txtApellido").val("");
            $("#txtNac").val("");
            $("#cboSexo").val("");
            $("#txtTelefono").val("");
            $("#textCorreo").val("");

            if (Json != null) {
                $("#txtId").val(Json.personaID);
                $("#txtNombre").val(Json.nombre);
                $("#txtApellido").val(Json.apellido);
                $("#txtNac").val(Json.fechaNacimiento);
                $("#cboSexo").val(Json.genero == "Masculino" ? 1 : 2); //Nota: Revisar en caso de que sea otro.
                $("#txtTelefono").val(Json.telefono);
                $("#textCorreo").val(Json.correo);
            }

            $("#formodal").modal("show");
        }

        // $.ajax({//Utilizando ajax para obtener los usuarios, recomiendo investigar mas.
        //     url: listarPersona, //Llamamos al metodo desde el HomeController
        //     type: "GET",
        //     dataType: "Json",
        //     contentType: "application/json; charset=utf-8",
        //     success: function (data) {

        //         console.log(data)
        //     }
        // })

        $(document).ready(function () {
                table = $("#tabla").DataTable({
                responsive: true,
                ordering: true,
                paging: true,
                info: true,
                lengthChange: true,
                ajax: {
                    url: listarPersona,
                    type: "GET",
                    dataType: "json"
                },
                columns: [
                    { data: "nombre" },
                    { data: "apellido" },
                    { data: "fechaNacimiento" },
                    { data: "genero" },
                    { data: "telefono" },
                    { data: "correo" },
                    // { data: "fechaCambio" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-warning btn-sm btn-editar"><i class="bi bi-pencil"></i></button>' +
                            '<button type="button"class="btn btn-danger btn-sm ms-2"><i class="bi bi-trash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "90px"
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/es-MX.json',
                },
            });

            $("#tabla tbody").on("click", ".btn-editar", function () {
                filaSeleccionada = table.row($(this).closest("tr")).data();
                var data = table.row(filaSeleccionada).data();
                abrirModal(data);
            }); 
        });
        function Guardar() {
            var Persona = {
                personaID: $("#txtId").val(),
                nombre: $("#txtNombre").val(),
                apellido: $("#txtApellido").val(),
                fechaNacimiento: $("#txtNac").val(),
                genero: $("#cboSexo").val(),
                telefono: $("#txtTelefono").val(),
                correo: $("#textCorreo").val()
            };

            $.ajax({
                url: GuardarPersona,
                type: "POST",
                data: JSON.stringify({ objeto: Persona }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.resultado != 0) {
                        if (Persona.personaID == 0) {
                            Persona.personaID = data.resultado;
                            table.row.add(Persona).draw(false);
                        } else {
                            table.row(filaSeleccionada).data(Persona).draw(false);
                        }
                        $("#formodal").modal("hide");
                    } else {
                        alert(data.mensaje);
                    }
                }
            });
        }

    </script>
}

