@model IEnumerable<gestion_de_permiso_de_usuario.Models.Persona>

@{
    ViewData["Title"] = "Lista de Personas";
}

<p>
    @* <a asp-action="Create" class="btn btn-primary">Crear Nueva Persona</a> *@
</p>
<div class="table-responsive">
    <table id="peopleTable" class="display" style="width:100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Fecha de Nacimiento</th>
                <th>Género</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.PersonaID)</td>
                    <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                    <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                    <td>@Html.DisplayFor(modelItem => item.FechaNacimiento)</td>
                    <td>@Html.DisplayFor(modelItem => item.Genero)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                    <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                    <td>
                        <div class="btn-group" role="group" aria-label="Basic example">
                            <button type="button" class="btn btn-warning btn-sm btn-editar"><i class="bi bi-pencil"></i></button>
                            <button type="button" class="btn btn-danger btn-sm ms-2"><i class="bi bi-trash"></i></button>
                           @*  <a asp-action="Edit" asp-route-id="@item.PersonaID" class="btn btn-warning" onclick="abrirModal(null)"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.PersonaID" class="btn btn-info"><i class="bi bi-eye"></i></a> *@
                        </div>
                    </td>
                </tr>
            }
    
        </tbody>
    </table>
</div>
<div class="modal" tabindex="-1" id="formodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body g-2">

                <input id="txtId" type="hidden" value="0" />

                <div class="row">

                    <form>
                        @* @Html.AntiForgeryToken() *@

                        <div class="mb-3">
                            <label for="txtNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="txtNombre">
                        </div>

                        <div class="mb-3">
                            <label for="txtApellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="txtApellido">
                        </div>

                        <div class="mb-3">
                            <label for="txtNac" class="form-label">Fecha de nacimiento</label>
                            <input type="date" class="form-control" id="txtNac">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Sexo</label>
                            <select class="form-select" id="cboSexo" aria-label="Default select example">
                                <option selected>Selecciona tu sexo</option>
                                <option value="1">Hombre</option>
                                <option value="2">Mujer</option>
                                <option value="3">Otro</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="txtTelefono" class="form-label">Numero de telefono</label>
                            <input type="text" class="form-control" id="txtTelefono">
                        </div>

                        <div class="mb-3">
                            <label for="textCorreo" class="form-label">Correo </label>
                            <input type="text" class="form-control" id="textCorreo">
                        </div>

                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button> @* En desarrollo *@
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table; 
        var filaSeleccionada;
        let listarPersona = `@Url.Action("GetPersonas", "People")`;
        let GuardarPersona = `@Url.Action("Edit", "Persona")`;

        function abrirModal(Json) {
            $("#txtId").val(Json.personaID);
            $("#txtNombre").val(Json.nombre);
            $("#txtApellido").val(Json.apellido);
            $("#txtNac").val(Json.fechaNacimiento);
            $("#cboSexo").val(Json.genero === "Masculino" ? 1 : (Json.genero === "Femenino" ? 2 : 3));
            $("#txtTelefono").val(Json.telefono);
            $("#textCorreo").val(Json.correo);

            $("#formodal").modal("show");
        }

        function Guardar() {
            const persona = {
                PersonaID: $("#txtId").val(),
                Nombre: $("#txtNombre").val(),
                Apellido: $("#txtApellido").val(),
                FechaNacimiento: $("#txtNac").val(),
                Genero: $("#cboSexo").val() === "1" ? "Masculino" : ($("#cboSexo").val() === "2" ? "Femenino" : "Otro"),
                Telefono: $("#txtTelefono").val(),
                Correo: $("#textCorreo").val()
            };

            fetch('/Persona/UpdatePersona', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(persona)
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(err => { throw new Error(err.message); });
                    }
                    return response.json();
                })
                .then(data => {
                    console.log(data.message);
                    location.reload(); // Recargar la página para ver los cambios
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(error.message); // Mostrar el error en una alerta
                });
        }


        $.ajax({//Utilizando ajax para obtener los usuarios, recomiendo investigar mas.
            url: listarPersona, //Llamamos al metodo desde el HomeController
            type: "GET",
            dataType: "Json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                console.log(data)
            }
        })

        $(document).ready(function () {
            var table = $('#peopleTable').DataTable({
                "paging": true,
                "searching": true,
                "info": true,
                "lengthChange": true,
                "pageLength": 10,
                "language": {
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ registros por página",
                    "zeroRecords": "No se encontraron resultados",
                    "info": "Mostrando página _PAGE_ de _PAGES_",
                    "infoEmpty": "No hay registros disponibles",
                    "infoFiltered": "(filtrado de _MAX_ registros en total)",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            $("#peopleTable").on("click", ".btn-editar", function () {
                var fila = $(this).closest("tr");
                var data = table.row(fila).data();
                var personaId = data[0];  // Suponiendo que el ID está en la primera columna

                $.ajax({
                    url: `/Persona/GetPersonaById/${personaId}`,
                    type: "GET",
                    success: function (response) {
                        abrirModal(response);
                    },
                    error: function () {
                        alert("Error al obtener los datos de la persona.");
                    }
                });
        });
       });
        
    </script>
}
