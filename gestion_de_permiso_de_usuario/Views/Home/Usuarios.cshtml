@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
    <li class="breadcrumb-item">Resumen</li>
    <li class="breadcrumb-item active">Usuarios</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="bi bi-people me-1"></i> Lista de Usuarios
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3 mt-3">Nuevo</button>
            </div>

            <hr />
            <table class="table datatable w-100" id="tabla"></table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let listarUsuario = `@Url.Action("ListaUsuarios", "Home")`;

        // $.ajax({//Utilizando ajax para obtener los usuarios, recomiendo investigar mas.
        //     url: '@Url.Action("ListaUsuarios","Home")', //Llamamos al metodo desde el HomeController
        //     type: "GET",
        //     dataType: "Json",
        //     contentType: "application/json; charset=utf-8",
        //     success: function (data) {

        //         console.log(data)
        //     }
        // }) 
        
        $(document).ready(function () {
            $("#tabla").DataTable({
                info:false,
                destroy:true,
                ajax: {
                    url:listarUsuario,
                    type: "GET",
                    dataType: "application/json",
                    dataSrc:""

                },
                columns: [
                    { data: "NombreUsuario", title: "Username"},
                    { data: "PersonaID" },
                    { data: "RolID" },
                    { data: "FechaCambio" },
                    { data: "Estado" },
                    { data: "CreadoPor" }
                ]
            });
            // $.ajax({
            //     url: listarUsuario,
            //     type: "GET",
            //     dataType: "application/json",
            //     contentType: 'json',
            //     success: (response) =>{
            //         console.log(response);
            //     }
            // });
        });

    </script>
}
